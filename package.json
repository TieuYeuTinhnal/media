{
  "name": "spine-particle-studio",
  "version": "1.1.0",
  "description": "Electron-based desktop application for particle effects creation and Spine2D export",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "dev": "tsc && electron .",
    "watch": "tsc --watch",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "keywords": [
    "electron",
    "particle",
    "spine",
    "animation",
    "physics"
  ],
  "author": "Spine Particle Studio",
  "license": "MIT",
  "devDependencies": {
    "@types/matter-js": "^0.19.6",
    "@types/node": "^20.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "matter-js": "^0.19.0"
  },
  "build": {
    "appId": "com.spineparticlestudio.app",
    "productName": "Spine Particle Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "index.html",
      "styles.css",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Graphics"
    }
  }
}
